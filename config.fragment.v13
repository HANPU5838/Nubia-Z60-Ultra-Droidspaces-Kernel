CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---------- v1.3: only ABI-verified-safe groups ----------
# Verified against the 270 vendor modules' __versions CRC table:
#   g2 diag: PASS, g3 nfs/9p: PASS, g4 btrfs: PASS, g5 bbr/cake: PASS, g7 usb/bt/ppp: PASS
# Rejected: nftables/bridge-netfilter (breaks device/netdevice CRCs)
#           zswap (breaks v4l2/video CRCs)

# g2 socket diagnostics
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_NETLINK_DIAG=y

# g3 NFS + 9P
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_9P_FS=y

# g4 BTRFS
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# g5 congestion control
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_CAKE=y

# g7 USB / BT / PPP drivers
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_BT_HCIBTUSB=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USBNET=y
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y
