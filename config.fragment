# Droidspaces options for NX721J (nubia Z60 Ultra, sm8650, ACK android14-6.1 @ 716498f88d0f)
# Base: the device's own /proc/config.gz (MyOS 14.5.6MR2)
#
# ABI-safe ONLY together with patches/001.GKI-below-6.12-fix_sysvipc_kabi_6_7_8.patch
# Do NOT add CONFIG_CFS_BANDWIDTH / CONFIG_CGROUP_PIDS (they break the GKI kABI).

# IPC (needs the kABI patch)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# Device filesystem (containers need /dev)
CONFIG_DEVTMPFS=y

# Networking (enhanced NAT support for --net=nat)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- optional but recommended ---
CONFIG_USER_NS=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y

# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# NixOS / posix acl on tmpfs
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Keep the stock version string so vendor_dlkm modules keep loading
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
